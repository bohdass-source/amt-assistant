# ── Domain and HTTPS ──────────────────────────────────────────
# localhost: demo with a local Caddy certificate. On a server: your domain.
DOMAIN=localhost
ACME_EMAIL=

# ── Secrets (change all of them) ──────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@amt.local
ADMIN_PASSWORD=change-me-admin-password
# If set, /api/search requires the x-api-key header (for the rag-probe test bench).
SEARCH_API_KEY=

# ── Models ────────────────────────────────────────────────────
# Embeddings: a multilingual model in Ollama (ollama pull bge-m3).
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# Generation: an OpenAI-compatible llm-gateway (POST {LLM_BASE_URL}/chat/completions).
# For a demo without a gateway, use Ollama directly:
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
# Turns off reasoning in qwen3.x and similar models; otherwise the query rewrite takes minutes.
LLM_REASONING_EFFORT=none
# Optional faster model for the query rewrite; empty means LLM_MODEL.
LLM_REWRITE_MODEL=

# Refusal threshold: minimum cosine similarity of the best excerpt.
MIN_VECTOR_SIMILARITY=0.45
