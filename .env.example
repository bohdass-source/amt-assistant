# ── Домен и HTTPS ─────────────────────────────────────────────
# localhost — демо с локальным сертификатом Caddy; на сервере — ваш домен.
DOMAIN=localhost
ACME_EMAIL=

# ── Секреты (обязательно поменять) ────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@amt.local
ADMIN_PASSWORD=change-me-admin-password
# Если задан — /api/search требует заголовок x-api-key (для стенда rag-probe).
SEARCH_API_KEY=

# ── Модели ────────────────────────────────────────────────────
# Embeddings: мультиязычная модель в Ollama (ollama pull bge-m3).
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# Генерация: OpenAI-совместимый llm-gateway (POST {LLM_BASE_URL}/chat/completions).
# Для демо без гейтвея — Ollama напрямую:
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
# Отключает «размышления» у qwen3.x и похожих моделей: иначе перевод вопроса занимает минуты.
LLM_REASONING_EFFORT=none
# Отдельная (быстрая) модель для перевода вопроса; пусто — та же LLM_MODEL.
LLM_REWRITE_MODEL=

# Порог отказа: минимальное косинусное сходство лучшего фрагмента.
MIN_VECTOR_SIMILARITY=0.45
