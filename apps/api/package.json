{
  "name": "@amt/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "eval": "tsc -p tsconfig.build.json && node dist/scripts/eval.js",
    "test:offline": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.4",
    "@langchain/textsplitters": "^1.0.2",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "chromadb": "^3.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
