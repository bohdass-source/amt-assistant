# DOMAIN=localhost → Caddy issues a local certificate (demo).
# DOMAIN=amt.example.org → automatic Let's Encrypt (the A record must point at the server).
# No ACME contact email: Let's Encrypt issues certificates without one.

{$DOMAIN:localhost} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API: no compression and immediate flush, otherwise the chat SSE stream arrives in one piece.
	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
