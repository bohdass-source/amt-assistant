# DOMAIN=localhost → Caddy выпускает локальный сертификат (демо).
# DOMAIN=amt.example.org → автоматический Let's Encrypt (A-запись должна указывать на сервер).
{
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN:localhost} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API: без сжатия и с немедленным flush, иначе SSE-стрим чата приходит одним куском.
	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
